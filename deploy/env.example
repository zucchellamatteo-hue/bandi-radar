# Bandi Radar - variabili di configurazione.
# Copia questo file in /srv/bandi-radar/.env e compila ogni riga (istruzioni in deploy/README.md).
# Il file .env NON va nel repository: contiene le password.

# ----- Sito web -----

# Indirizzo pubblico del sito. Se lasci vuoto vale finanzagevolata.qiaro.it (il DNS punta gia' al server).
SITE_ADDRESS=

# Email comunicata a Let's Encrypt quando chiede il certificato HTTPS (obbligatoria).
ACME_EMAIL=

# Primo amministratore (dal 05/10 si entra con email e password, tabella utenti). Finche' non esiste nessun
# amministratore, chi entra con questo nome utente e questa password diventa il primo admin; poi non servono piu'.
BASIC_AUTH_USER=

# Password del primo amministratore. Generane una lunga, per esempio con: openssl rand -base64 24
BASIC_AUTH_PASSWORD=

# Indirizzo del sito usato nei link delle email (invito, nuova password). Vuoto = https://finanzagevolata.qiaro.it
SITO_URL=

# ----- Database Postgres -----

# Utente del database. Se lasci vuoto vale "postgres": il backup notturno lo da' per scontato, non cambiarlo.
POSTGRES_USER=

# Password del database (obbligatoria). Generala con: openssl rand -base64 24
POSTGRES_PASSWORD=

# Nome del database. Se lasci vuoto vale "bandi_radar".
POSTGRES_DB=

# ----- Raccolta -----

# Ogni quanti secondi il servizio di raccolta controlla se ci sono fonti da visitare (vuoto = 3600, un'ora).
# La frequenza di ogni fonte e' nel registro fonti/: qui si decide solo ogni quanto guardare l'orologio.
RACCOLTA_INTERVALLO_SECONDI=

# ----- Email (Resend) -----

# Chiave API di Resend. Finche' manca, i riepiloghi vengono solo scritti nel log del servizio raccolta.
RESEND_API_KEY=

# Indirizzo a cui mandare il riepilogo del lunedi' (Matteo).
EMAIL_MATTEO=

# Le imprese possono registrarsi da sole (1) o solo su invito dalla pagina Utenti (vuoto o 0, fase di prova).
REGISTRAZIONE_APERTA=

# Email settimanali alle imprese: vuoto o 1 = partono solo dopo l'approvazione nella pagina Imprese; 0 = partono da sole.
EMAIL_IMPRESE_APPROVAZIONE=

# Pagina pubblica di presentazione su "/" per chi non ha fatto l'accesso (1). Vuoto o 0: "/" porta all'accesso e la
# presentazione si vede solo su /presentazione (anteprima, non indicizzata). Da accendere dopo le decisioni sui prezzi.
PAGINA_PUBBLICA=

# ID di Google Ads (es. AW-123456789) per misurare le campagne: il tag parte solo se il visitatore accetta i cookie.
GOOGLE_ADS_ID=

# Schede di esempio nella presentazione: numeri dei bandi separati da virgola. Vuoto = scelte in automatico.
ESEMPI_BANDI=

# Mittente. Se vuoto: "Bandi Radar <novita@finanzagevolata.qiaro.it>" (il dominio va verificato su Resend).
EMAIL_MITTENTE=

# ----- IA (Anthropic) -----
# Chiave API della Console Anthropic (console.anthropic.com), con un tetto di spesa mensile impostato li'.
# MAI le credenziali dell'abbonamento Claude. Finche' e' vuota l'IA e' spenta: smistamento e schede restano
# alle regole e a Matteo (python -m app.schede.ia stato lo conferma).
ANTHROPIC_API_KEY=
# Tetto di spesa mensile anche nel programma, in dollari (oltre a quello della Console). Se vuoto: 30.
IA_TETTO_MESE_USD=
# 1 = anche le schede con l'API (circa 0,05-0,45 $ l'una); 0 o vuoto = schede scritte nelle sessioni di Claude Code
IA_SCHEDE_API=

# Controlli preliminari con chiamate dirette (1: la scheda parte prima, ma costano il doppio). Vuoto o 0 = a lotti
# con la Batch API, a meta' prezzo, risposta entro 24 ore (decisione del 05/10: tutto il lavoro pesante a lotti).
IA_PRELIMINARI_DIRETTI=

# ----- Catena automatica -----
# Ogni ora, dopo la raccolta: smistamento a regole, deduplica, pagina ufficiale (20 bandi) e allegati (10 bandi);
# con ANTHROPIC_API_KEY anche l'IA con la Batch API (meta' prezzo, risposte entro 24 ore). 0 per spegnerla.
CATENA_AUTOMATICA=
