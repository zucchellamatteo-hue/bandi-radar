# Bandi Radar - variabili di configurazione.
# Copia questo file in /srv/bandi-radar/.env e compila ogni riga (istruzioni in deploy/README.md).
# Il file .env NON va nel repository: contiene le password.

# ----- Sito web -----

# Indirizzo pubblico del sito. Se lasci vuoto vale finanzagevolata.qiaro.it (il DNS punta gia' al server).
SITE_ADDRESS=
# Indirizzi secondari rinviati con un 301 al principale, separati da virgola (dal 07/10/2026:
# SITE_ADDRESS=bandinqiaro.it e SITE_ALTRI=www.bandinqiaro.it, finanzagevolata.qiaro.it).
SITE_ALTRI=

# Email comunicata a Let's Encrypt quando chiede il certificato HTTPS (obbligatoria).
ACME_EMAIL=

# Primo amministratore (dal 05/10 si entra con email e password, tabella utenti). Finche' non esiste nessun
# amministratore, chi entra con questo nome utente e questa password diventa il primo admin; poi non servono piu'.
BASIC_AUTH_USER=

# Password del primo amministratore. Generane una lunga, per esempio con: openssl rand -base64 24
BASIC_AUTH_PASSWORD=

# Indirizzo del sito usato nei link delle email (invito, nuova password) e, per la SEO, negli URL canonici, nella sitemap
# e in /llms.txt. Vuoto = https://finanzagevolata.qiaro.it. Al passaggio a bandinqiaro.it: SITO_URL=https://bandinqiaro.it
SITO_URL=

# ----- Database Postgres -----

# Utente del database. Se lasci vuoto vale "postgres": il backup notturno lo da' per scontato, non cambiarlo.
POSTGRES_USER=

# Password del database (obbligatoria). Generala con: openssl rand -base64 24
POSTGRES_PASSWORD=

# Nome del database. Se lasci vuoto vale "bandi_radar".
POSTGRES_DB=

# ----- Raccolta -----

# Ogni quanti secondi il servizio di raccolta controlla se ci sono fonti da visitare (vuoto = 3600, un'ora).
# La frequenza di ogni fonte e' nel registro fonti/: qui si decide solo ogni quanto guardare l'orologio.
RACCOLTA_INTERVALLO_SECONDI=

# ----- Email (Resend) -----

# Chiave API di Resend. Finche' manca, i riepiloghi vengono solo scritti nel log del servizio raccolta.
RESEND_API_KEY=

# Indirizzo a cui mandare il riepilogo del lunedi' (Matteo).
EMAIL_MATTEO=

# Le imprese possono registrarsi da sole (1) o solo su invito dalla pagina Utenti (vuoto o 0, fase di prova).
REGISTRAZIONE_APERTA=

# Email settimanali alle imprese: vuoto o 1 = partono solo dopo l'approvazione nella pagina Imprese; 0 = partono da sole.
EMAIL_IMPRESE_APPROVAZIONE=

# Pagina pubblica di presentazione su "/" per chi non ha fatto l'accesso (1). Vuoto o 0: "/" porta all'accesso e la
# presentazione si vede solo su /presentazione (anteprima, non indicizzata). Da accendere dopo le decisioni sui prezzi.
PAGINA_PUBBLICA=

# ID di Google Ads (es. AW-123456789) per misurare le campagne: il tag parte solo se il visitatore accetta i cookie.
GOOGLE_ADS_ID=

# Schede di esempio nella presentazione: numeri dei bandi separati da virgola. Vuoto = scelte in automatico.
ESEMPI_BANDI=

# ID di Google Analytics 4 (es. G-XXXXXXX): come Google Ads, parte solo dopo il consenso nel banner. Se si usa, va
# aggiunto alla cookie policy (app/pubblico/testi/cookie.html).
GOOGLE_ANALYTICS_ID=

# Nel piede della landing: chi gestisce il sito, es. "Studio Rossi · P.IVA 01234567890" (Google Ads lo chiede).
TITOLARE_SITO=

# Chi firma gli articoli del blog (/blog) senza un autore scritto, es. "Mario Rossi, commercialista". Vuoto = segnaposto
# "[NOME E COGNOME], commercialista", da sostituire prima di pubblicare (per Google conta una persona vera e competente).
AUTORE_ARTICOLI=

# Profili ufficiali (LinkedIn, Google Business Profile...), https separati da virgola: vanno nei dati strutturati (sameAs).
PROFILI_SOCIAL=

# ----- Abbonamenti (Stripe) -----
# 1 = l'area impresa richiede un abbonamento o la prova gratuita; vuoto o 0 = tutti entrano (fase di prova con amici).
ABBONAMENTI_ATTIVI=
# Giorni di prova gratuita (vuoto = 14, da decidere con Matteo).
PROVA_GIORNI=
# 1 = i prezzi in Stripe sono IVA inclusa; vuoto o 0 = IVA esclusa (da decidere con Matteo).
PREZZI_IVA_INCLUSA=
# Chiave segreta di Stripe: SOLO di prova (sk_test_...) finche' STRIPE_PAGAMENTI_VERI non e' 1. Dalla dashboard di
# Stripe, Sviluppatori > Chiavi API. Mai in chat o nel repository.
STRIPE_SECRET_KEY=
# Segreto del webhook (whsec_...): Stripe > Sviluppatori > Webhook, indirizzo https://finanzagevolata.qiaro.it/api/stripe/webhook,
# eventi checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=
# Configurazioni del portale clienti create da "python -m app.abbonamenti prepara-stripe" (con e senza disdetta).
STRIPE_PORTALE=
STRIPE_PORTALE_ANNUALE=
# 1 = accetta la chiave vera di Stripe (pagamenti veri). Solo con il via di Matteo.
STRIPE_PAGAMENTI_VERI=
# Aliquota IVA 22% creata da "prepara-stripe": Stripe la aggiunge ai prezzi, che sono IVA esclusa.
STRIPE_IVA_22=

# ----- Fattura elettronica (Invoicetronic) -----
# 1 = a ogni pagamento Stripe si crea e si invia la fattura elettronica; il cliente deve dare i dati di fatturazione.
FATTURE_ATTIVE=
# Chiave API di Invoicetronic (dashboard): ik_test_... per la sandbox. La chiave vera (ik_live_) solo con FATTURE_VERE=1.
INVOICETRONIC_API_KEY=
FATTURE_VERE=
# Segreto del webhook di Invoicetronic (indirizzo https://finanzagevolata.qiaro.it/api/invoicetronic/webhook, evento update.add).
INVOICETRONIC_WEBHOOK_SECRET=
# Chi emette le fatture (studio o societa': decisione di Matteo). Regime fiscale: RF01 ordinario, RF19 forfettario.
FATTURE_EMITTENTE_DENOMINAZIONE=
FATTURE_EMITTENTE_PARTITA_IVA=
FATTURE_EMITTENTE_CODICE_FISCALE=
FATTURE_EMITTENTE_REGIME=
FATTURE_EMITTENTE_INDIRIZZO=
FATTURE_EMITTENTE_CAP=
FATTURE_EMITTENTE_COMUNE=
FATTURE_EMITTENTE_PROVINCIA=

# Mittente. Se vuoto: "Bandi Radar <non-rispondere@DOMINIO>", con il dominio di SITO_URL (va verificato su Resend).
EMAIL_MITTENTE=

# Indirizzo da indicare nelle email automatiche per le domande ("non rispondere: scrivi a ..."). Vuoto = nessun indirizzo.
EMAIL_CONTATTO=

# ----- IA (Anthropic) -----
# Chiave API della Console Anthropic (console.anthropic.com), con un tetto di spesa mensile impostato li'.
# MAI le credenziali dell'abbonamento Claude. Finche' e' vuota l'IA e' spenta: smistamento e schede restano
# alle regole e a Matteo (python -m app.schede.ia stato lo conferma).
ANTHROPIC_API_KEY=
# Tetto di spesa mensile anche nel programma, in dollari (oltre a quello della Console). Se vuoto: 30.
IA_TETTO_MESE_USD=
# 1 = anche le schede con l'API (circa 0,05-0,45 $ l'una); 0 o vuoto = schede scritte nelle sessioni di Claude Code
IA_SCHEDE_API=
# 1 = con l'API anche le schede dei bandi solo per il non profit (associazioni, ETS, ASD...), sempre dopo quelle per
# le imprese; 0 o vuoto = quei bandi si schedano solo nelle sessioni di Claude Code (decisione del 07/10: budget)
SCHEDE_NON_PROFIT=

# Controlli preliminari con chiamate dirette (1: la scheda parte prima, ma costano il doppio). Vuoto o 0 = a lotti
# con la Batch API, a meta' prezzo, risposta entro 24 ore (decisione del 05/10: tutto il lavoro pesante a lotti).
IA_PRELIMINARI_DIRETTI=

# ----- Catena automatica -----
# Ogni ora, dopo la raccolta: smistamento a regole, deduplica, pagina ufficiale (20 bandi) e allegati (10 bandi);
# con ANTHROPIC_API_KEY anche l'IA con la Batch API (meta' prezzo, risposte entro 24 ore). 0 per spegnerla.
CATENA_AUTOMATICA=

# ----- Backup esterno (OVH Object Storage, S3) -----
# Spazio "bandi-radar-backup" a Strasburgo, utente con ruolo "Operatore Object Storage" (07/10/2026).
# Le chiavi si inseriscono solo qui, sul server. deploy/backup_esterno.sh le usa ogni notte.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGIONE=
BACKUP_S3_CONTENITORE=
BACKUP_S3_CHIAVE=
BACKUP_S3_SEGRETO=

