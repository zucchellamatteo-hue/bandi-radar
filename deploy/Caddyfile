# Caddy: HTTPS automatico (Let's Encrypt) davanti all'applicazione.
# SITE_ADDRESS e ACME_EMAIL arrivano dal file .env tramite docker-compose.yml.
# L'autenticazione base la fa l'applicazione (utente e password in .env), non Caddy.
{
	email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy app:8000
}

# Indirizzi secondari (dal 07/10/2026: www e il vecchio finanzagevolata.qiaro.it) -> rinvio permanente (301) al dominio
# principale, conservando il percorso: Google trasferisce la reputazione e i vecchi link continuano a funzionare.
# Se SITE_ALTRI non e' impostato, docker-compose.yml mette il nome fittizio http://alias.invalid (nessun certificato).
{$SITE_ALTRI} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}

