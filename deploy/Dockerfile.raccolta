# Immagine del servizio di raccolta: come l'app, piu' Chromium (Playwright) per le fonti che
# caricano l'elenco via JavaScript. Parte dall'immagine ufficiale Playwright per Python.
FROM mcr.microsoft.com/playwright/python:v1.52.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /srv/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY fonti ./fonti

# Il browser non gira come root. Numero utente fisso (10001, come nel Dockerfile dell'app) e cartella
# degli allegati gia' sua: Docker copia proprietario e permessi nel volume quando lo crea.
RUN useradd --system --create-home --uid 10001 appuser && chown -R appuser /srv/app \
    && mkdir -p /srv/allegati && chown appuser /srv/allegati
USER appuser

CMD ["python", "-m", "app.raccolta.demone"]
